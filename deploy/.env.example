LIFELOG_HOSTNAME=your-ddns-hostname.example.com
LIFELOG_API_KEY=replace-with-long-random-api-key
LIFELOG_VAULTS_PATH=/srv/lifelog/vaults

POSTGRES_USER=lifelog
